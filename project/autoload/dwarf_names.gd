extends Node

func make_dwarf_name() -> String:
	var generated_name:String = _get_first_name() + "\n" + _get_last_name()
	
	if generated_name in _banned_full_names:
		generated_name = make_dwarf_name()
	else:
		_banned_full_names.append(generated_name)
	
	print_debug(generated_name)
	return generated_name

func clear_ban_list() -> void:
	_banned_full_names = []

func _get_first_name() -> String:
	var chosen_first_name:String = _first_names.pick_random()
	return chosen_first_name

func _get_last_name() -> String:
	var chosen_last_name:String = _last_names_prefixes.pick_random() + "-" + _last_name_suffixes.pick_random()
	return chosen_last_name

